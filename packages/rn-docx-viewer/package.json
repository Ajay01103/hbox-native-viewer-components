{
  "name": "@hbox/rn-docx-viewer",
  "version": "0.0.0",
  "description": "Native DOCX viewer for React Native, painted with native views",
  "license": "MIT",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm build",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hbox/react-native-nitro-docx": ">=0.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hbox/react-native-nitro-docx": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "typescript": "catalog:"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
