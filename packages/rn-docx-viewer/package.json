{
  "name": "@hbox/rn-docx-viewer",
  "version": "0.0.0",
  "description": "Native DOCX viewer for React Native with a Tamagui chrome, built on @hbox/react-native-nitro-docx",
  "license": "MIT",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": ["src", "lib", "!**/__tests__"],
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm build",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hbox/react-native-nitro-docx": ">=0.0.0",
    "@tamagui/lucide-icons": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "tamagui": "*"
  },
  "peerDependenciesMeta": {
    "@tamagui/lucide-icons": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hbox/react-native-nitro-docx": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "tamagui": "catalog:",
    "typescript": "catalog:"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["module", { "esm": false }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
