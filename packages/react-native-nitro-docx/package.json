{
  "name": "@hbox/react-native-nitro-docx",
  "version": "0.0.0",
  "description": "Nitro-based native DOCX engine (shared document, native pagination) for React Native",
  "license": "MIT",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "!**/__tests__",
    "!ios/build",
    "!android/build",
    "!android/.cxx"
  ],
  "scripts": {
    "codegen": "nitrogen",
    "build": "bob build",
    "prepack": "pnpm codegen && pnpm build",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "nitrogen": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "typescript": "catalog:"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
