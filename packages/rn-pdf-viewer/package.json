{
  "name": "@hbox/rn-pdf-viewer",
  "version": "0.0.0",
  "description": "Headless React Native PDF viewer built on @hbox/react-native-nitro-pdf",
  "license": "MIT",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "files": ["src", "lib", "!**/__tests__"],
  "scripts": {
    "build": "bob build",
    "prepack": "pnpm build",
    "check-types": "tsc --noEmit"
  },
    "peerDependencies": {
    "@hbox/react-native-nitro-pdf": ">=0.0.0",
    "@shopify/flash-list": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@hbox/react-native-nitro-pdf": "workspace:*",
    "@shopify/flash-list": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-builder-bob": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native-svg": "catalog:",
    "typescript": "catalog:"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["module", { "esm": false }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
