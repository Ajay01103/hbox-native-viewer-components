{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "hboxpdf"
  ],
  "ios": {
    "iosModuleName": "HboxNitroPdf"
  },
  "android": {
    "androidNamespace": [
      "hboxpdf"
    ],
    "androidCxxLibName": "HboxNitroPdf"
  },
  "autolinking": {
    "PdfDocument": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfDocument"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfDocument"
      }
    },
    "PdfPageView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfPageView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfPageView"
      }
    },
    "PdfEditorView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfEditorView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfEditorView"
      }
    }
  },
  "ignorePaths": [
    "node_modules"
  ]
}
