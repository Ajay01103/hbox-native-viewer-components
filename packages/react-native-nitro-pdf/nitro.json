{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["hboxpdf"],
  "ios": {
    "iosModuleName": "HboxNitroPdf"
  },
  "android": {
    "androidNamespace": ["hboxpdf"],
    "androidCxxLibName": "HboxNitroPdf"
  },
  "autolinking": {
    "PdfDocument": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfDocument"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfDocument"
      }
    },
    "PdfPageView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPdfPageView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPdfPageView"
      }
    }
  },
  "ignorePaths": ["node_modules"]
}
